extends Node2D
## Soft magical glow around the glowing mushrooms that are already drawn in
## 05_main.png.
##
## The artwork is not touched: the mushrooms stay exactly as painted. This node
## simply adds a cool blue-white halo over each cluster plus a faint pool of
## light on the ground beneath it, both drawn with additive blending so they
## brighten what is behind them. The halo breathes slowly, and two overlapping
## rings per mushroom pulse out of phase, which reads as a gentle magical
## shimmer instead of a hard blink.
##
## Mushroom positions come from forest_layers/mushroom_spots.json, which was
## generated by detecting the blue caps in the layer PNG.

@export var spots_path := "res://forest_layers/mushroom_spots.json"
@export var halo_texture: Texture2D
@export var pool_texture: Texture2D
## Halo scale per unit of mushroom size.
@export var halo_scale := 0.62
@export var min_halo := 1.6
@export var max_halo := 4.2
## How strong the halo and the ground pool get at their brightest.
@export var halo_strength := 1.35
@export var pool_strength := 0.55
## Ground pool is squashed flat, like the firefly pools.
@export var pool_squash := 0.42
@export var pool_stretch := 1.7
## Small mushrooms closer than this to a bigger one are folded into it, so the
## big caps get one clean halo instead of several overlapping ones.
@export var merge_distance := 26.0
## Bright clusters (the actual mushroom caps) are kept; tiny specks are dropped.
@export var min_pixels := 60

var _halos: Array[Sprite2D] = []
var _pools: Array[Sprite2D] = []
var _phase := PackedFloat32Array()
var _tempo := PackedFloat32Array()
var _halo_base := PackedFloat32Array()
var _pool_base := PackedFloat32Array()

var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	if halo_texture == null or pool_texture == null:
		push_warning("MushroomGlow: halo/pool texture missing, nothing will be drawn.")
		return
	_rng.randomize()
	if not _load_spots():
		return
	set_process(true)


func _load_spots() -> bool:
	var f := FileAccess.open(spots_path, FileAccess.READ)
	if f == null:
		push_warning("MushroomGlow: could not read " + spots_path)
		return false
	var data: Variant = JSON.parse_string(f.get_as_text())
	if typeof(data) != TYPE_DICTIONARY or not data.has("spots"):
		push_warning("MushroomGlow: unexpected contents in " + spots_path)
		return false

	var raw: Array = data["spots"]
	# Drop unimportant specks, then merge clusters that sit almost on top of
	# each other (the detector splits some caps into several pieces).
	var kept: Array = []
	for s in raw:
		if int(s.get("pixels", 0)) >= min_pixels:
			kept.append(s)
	kept.sort_custom(func(a, b): return int(a["pixels"]) > int(b["pixels"]))

	var merged: Array = []
	for s in kept:
		var duplicate := false
		for m in merged:
			if Vector2(float(s["x"]), float(s["y"])).distance_to(Vector2(m["x"], m["y"])) < merge_distance:
				duplicate = true
				break
		if not duplicate:
			merged.append(s)

	for s in merged:
		_add_mushroom(float(s["x"]), float(s["y"]), float(s["width"]), float(s["height"]))

	print("[mushroom glow] lit ", merged.size(), " mushrooms")
	return true


func _add_mushroom(x: float, y: float, width: float, height: float) -> void:
	# The cap centre sits a little above the cluster centre; the light pool goes
	# on the ground just under it.
	var size := clampf(maxf(width, height) * 0.5, 6.0, 40.0)
	var halo_size := clampf(size * halo_scale, min_halo, max_halo) * 0.5 + 1.2

	var halo := Sprite2D.new()
	halo.texture = halo_texture
	halo.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	halo.position = Vector2(x, y - height * 0.15)
	halo.scale = Vector2(halo_size, halo_size)
	halo.modulate = Color(1.0, 1.0, 1.0, 0.0)
	add_child(halo)
	_halos.append(halo)

	var pool := Sprite2D.new()
	pool.texture = pool_texture
	pool.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	pool.position = Vector2(x, y + height * 0.5 + 2.0)
	pool.scale = Vector2(halo_size * pool_stretch, halo_size * pool_squash)
	pool.modulate = Color(1.0, 1.0, 1.0, 0.0)
	add_child(pool)
	_pools.append(pool)

	_phase.append(_rng.randf_range(0.0, TAU))
	_tempo.append(_rng.randf_range(0.5, 1.1))
	_halo_base.append(halo_strength * _rng.randf_range(0.8, 1.15))
	_pool_base.append(pool_strength * _rng.randf_range(0.7, 1.1))


func _process(_delta: float) -> void:
	var t := Time.get_ticks_msec() / 1000.0
	for i in _halos.size():
		var phase := _phase[i]
		var tempo := _tempo[i]
		# Two slightly different frequencies: the halo swells and dips while the
		# ground pool lags behind it, so the light never looks mechanical.
		var breathe := 0.55 + 0.45 * (0.5 + 0.5 * sin(t * tempo + phase))
		var flicker := 0.9 + 0.1 * sin(t * tempo * 2.7 + phase * 1.9)
		_halos[i].modulate.a = _halo_base[i] * breathe * flicker
		_pools[i].modulate.a = _pool_base[i] * (0.5 + 0.5 * sin(t * tempo * 0.8 + phase + 0.9))
